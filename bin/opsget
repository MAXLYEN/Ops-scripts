#!/usr/bin/env bash
# bin/opsget — 从仓库拉取、安装和执行运维脚本
# VERSION: 1.4.1
# 1.4.1: 校验脚本路径（拒绝 .. 与非法字符）；帮助里的验证写法改为完整提交号。
# 配置依赖以目标脚本的 ENV-REQUIRED 声明为准。

set -o pipefail

die() { printf '[致命] %s\n' "$*" >&2; exit 1; }
log() { printf '%s\n' "$*"; }

# ref 只进 URL 路径，限定字符集，也挡掉 .. 这类路径穿越
valid_ref() {
  case "$1" in ''|*[!A-Za-z0-9._/-]*|*..*) return 1 ;; esac
}
# 脚本路径同理：它既拼进 URL，又决定装到哪个文件名
valid_path() {
  case "$1" in ''|/*|*..*|*[!A-Za-z0-9._/-]*) return 1 ;; esac
}

OPS_REPO="${OPS_REPO:-https://raw.githubusercontent.com/MAXLYEN/ops-scripts}"
# ref 判定：环境变量 OPS_REF（单次覆盖）> REF_FILE（opsget --pin 写入）> main。
# 生产机固定到验证过的 tag / 提交后，main 上的新提交不会在下次 opsget 时
# 自动装上 —— 否则 main 上一个坏提交，所有机器下次更新都会中招。
# common.sh 的 ops_base() 按同样顺序判定，改这里要同步改那里。
REF_FILE=/etc/ops-scripts/ref
if [ -n "${OPS_REF:-}" ]; then
  REF_SRC="环境变量 OPS_REF"
elif [ -s "$REF_FILE" ]; then
  OPS_REF=$(head -n1 "$REF_FILE"); REF_SRC="固定于 $REF_FILE"
else
  OPS_REF=main; REF_SRC="默认，未固定"
fi
# --unpin 放行：固定文件被改坏时，它正是修复手段
valid_ref "$OPS_REF" || [ "${1:-}" = --unpin ] || die "ref 不合法: '$OPS_REF'（来源：$REF_SRC）"
BASE="$OPS_REPO/$OPS_REF"
BIN_DIR=/usr/local/bin
LIB_DST=/usr/local/lib/ops-common.sh
ENV_DIR=/etc/ops-scripts
ENV_FILE="$ENV_DIR/env.conf"
LEDGER_DIR=/var/lib/ops-scripts
LEDGER="$LEDGER_DIR/installed.list"

usage() {
  cat <<'USAGE'
opsget — ops-scripts 引导器

  opsget -l                      列出可用脚本
  opsget <路径> [参数...]        拉取、安装并执行
  opsget -i <路径>               只安装，不执行
  opsget -u                      更新自身与 common.sh

版本固定：
  opsget --pin                   看当前从哪个 ref 拉取、来源是什么
  opsget --pin <tag|提交>        固定本机，之后只从这个 ref 拉取
  opsget --unpin                 取消固定，回到 main
  OPS_REF=<40位提交号> opsget -i <路径>
                                 单次覆盖固定（先在一台机上验证新提交）。
                                 别用 OPS_REF=main：raw 会缓存分支指向几分钟，刚推送后拉到的可能是旧版

配置（env.conf）：
  opsget -c                      按已装脚本的实际需要，补齐 env.conf
  opsget -c <路径>               只补这一个脚本要的键
  opsget -c all                  写入完整模板（所有键）
  opsget -e <路径>               看这个脚本需要哪些键、当前缺哪些

  已有的键连值一起保留，只追加缺失项，动手前自动备份。
  脚本头部没有 `# ENV-REQUIRED:` 声明的，表示它不需要配置，裸机可跑。
  声明里写成 `A|B` 表示二选一，任一有值即可（新键与旧键回落共存时用）。

路径写成 migrate/03-pre-migrate 或 migrate/03-pre-migrate.sh 都可以。
USAGE
}

[ "$(id -u)" -eq 0 ] || die "需要 root"
command -v curl >/dev/null 2>&1 || die "缺少 curl"

# 瞬时的 DNS / 路由故障不该让整条命令失败 —— 重试三次，间隔 3 秒
# 每次请求带唯一查询参数绕开 CDN 缓存（raw 会忽略未知参数）。
# 代价是不吃缓存、每次真回源，这点流量换「拉到的一定是最新的」值得。
curl_retry() {  # curl_retry <url> <落盘路径>
  local i url="$1"
  case "$url" in
    *\?*) url="$url&_=$(date +%s)" ;;
    *)    url="$url?_=$(date +%s)" ;;
  esac
  for i in 1 2 3; do
    curl -fsSL --max-time 60 --retry 2 --retry-connrefused "$url" -o "$2" && return 0
    [ "$i" -lt 3 ] && { log "[重试 $i/3] $1"; sleep 3; }
  done
  return 1
}

fetch() {  # fetch <仓库内路径> <落盘路径>
  local url="$BASE/$1" out=$2 tmp
  tmp=$(mktemp) || die "mktemp 失败"
  if ! curl_retry "$url" "$tmp"; then
    rm -f "$tmp"; die "拉取失败（已重试 3 次）: $url"
  fi
  [ -s "$tmp" ] || { rm -f "$tmp"; die "拉到空文件: $url"; }
  # 幂等：内容相同就不动，不同则备份旧版
  if [ -f "$out" ] && cmp -s "$tmp" "$out"; then
    log "[=] $out 已是最新"
    rm -f "$tmp"
  elif [ -f "$out" ]; then
    cp -a "$out" "$out.bak.$(date -u +%Y%m%d%H%M%S)"
    mv "$tmp" "$out"; log "[~] $out 已更新（旧版已备份）"
  else
    mkdir -p "$(dirname "$out")"
    mv "$tmp" "$out"; log "[+] $out 已安装"
  fi
  chmod 755 "$out"
  # 台账：记下装了什么，清理脚本据此精确回收，不会误删同目录下的其它脚本
  mkdir -p "$LEDGER_DIR"
  grep -qxF "$out" "$LEDGER" 2>/dev/null || printf '%s\n' "$out" >> "$LEDGER"
}

sync_lib() {
  local tmp; tmp=$(mktemp)
  if curl_retry "$BASE/lib/common.sh" "$tmp" && [ -s "$tmp" ]; then
    if [ -f "$LIB_DST" ] && cmp -s "$tmp" "$LIB_DST"; then rm -f "$tmp"
    else mkdir -p "$(dirname "$LIB_DST")"; mv "$tmp" "$LIB_DST"; chmod 644 "$LIB_DST"
         log "[~] common.sh 已更新"; fi
    mkdir -p "$LEDGER_DIR"
    grep -qxF "$LIB_DST" "$LEDGER" 2>/dev/null || printf '%s\n' "$LIB_DST" >> "$LEDGER"
  else
    rm -f "$tmp"; [ -f "$LIB_DST" ] || die "common.sh 拉取失败且本地没有"
    log "[警告] common.sh 拉取失败，沿用本地版本"
  fi
}

# ── 配置依赖（ENV-REQUIRED）──────────────────────────────────
# 约定：脚本头部一行 `# ENV-REQUIRED: KEY1 KEY2 ...`，列出缺了就会 die 的键。
# 有回落值、留空即跳过的键**不写进去** —— 写了等于把可选变必填，
# 节点机会被逼着填一堆用不上的项，按需化就白做了。

env_keys_of() {  # $1=脚本文件路径；输出键名，每行一个
  [ -f "$1" ] || return 0
  sed -n 's/^#[[:space:]]*ENV-REQUIRED:[[:space:]]*//p' "$1" \
    | tr ' \t' '\n\n' | sed '/^$/d' | sort -u
}

# 声明 token 可写成 `A|B`：任一有值即算满足，报缺时报首选（第一个）。
# 这是给「新键 + 旧键回落」用的 —— 脚本内部有回落，预检就不该按字面拦。
env_missing_keys() {  # $@=声明 token；输出缺失项的首选键名
  local k a ok
  ( set +u
    # shellcheck disable=SC1090
    [ -f "$ENV_FILE" ] && . "$ENV_FILE" 2>/dev/null
    for k in "$@"; do
      ok=""
      for a in ${k//|/ }; do [ -n "${!a:-}" ] && { ok=1; break; }; done
      [ -n "$ok" ] || printf '%s\n' "${k%%|*}"
    done )
}

env_missing() {  # $1=脚本文件路径；输出缺失的键，无输出=齐了
  local keys; keys=$(env_keys_of "$1")
  [ -n "$keys" ] || return 0
  env_missing_keys $keys
}

tpl_keys() {  # $1=模板文件；输出模板里定义的所有键
  grep -oE '^[[:space:]]*(export[[:space:]]+)?[A-Z_][A-Z0-9_]*=' "$1" \
    | sed -E 's/^[[:space:]]*(export[[:space:]]+)?//; s/=$//' | sort -u
}

# 键的值可能引用别的键（PANEL_VHOST_DIR="${PANEL_ROOT}/vhost/nginx"）。
# 只搬 PANEL_VHOST_DIR 而漏掉 PANEL_ROOT，值会展开成 /vhost/nginx —— 一个
# 看起来像路径、实际指向根目录的值，比报错危险得多。所以要做依赖闭包。
env_closure() {  # $1=模板 $2=键列表（空格或换行分隔，可含 A|B）
  local tpl=$1 want prev refs all
  all=$(tpl_keys "$tpl")
  # A|B 只生成首选键 —— 回落键是给老机器用的，新写的 env.conf 不该再引导人去填它
  want=$(printf '%s\n' $2 | sed '/^$/d; s/|.*//' | sort -u)
  while :; do
    prev=$want
    refs=$(for k in $want; do
             sed -nE "s/^[[:space:]]*(export[[:space:]]+)?$k=//p" "$tpl" \
               | grep -oE '\$\{?[A-Z_][A-Z0-9_]*\}?' | tr -d '${}'
           done | sed '/^$/d' | sort -u)
    want=$(printf '%s\n%s\n' "$want" "$refs" | sed '/^$/d' | sort -u \
           | comm -12 - <(printf '%s\n' "$all"))
    [ "$want" = "$prev" ] && break
  done
  printf '%s\n' "$want"
}

installed_keys() {  # 已装脚本（含台账）声明的键的并集
  local f
  { [ -f "$LEDGER" ] && cat "$LEDGER"
    ls "$BIN_DIR"/*.sh 2>/dev/null
  } | sort -u | while read -r f; do
        [ -f "$f" ] && env_keys_of "$f"
      done | sort -u
}

env_merge() {  # $1=模板 $2...=要写入的键
  local tpl=$1; shift
  local want=" $* " added=0 buf="" line k sec="" sec_done=""
  mkdir -p "$ENV_DIR"; chmod 700 "$ENV_DIR"
  if [ -f "$ENV_FILE" ]; then
    cp -a "$ENV_FILE" "$ENV_FILE.bak.$(date -u +%Y%m%d%H%M%S)"
  else
    { echo "# ops-scripts env.conf —— 由 opsget -c 按需生成"
      echo "# 只含本机已装脚本实际需要的项。装了新脚本后再跑一次 opsget -c 会自动补齐。"
      echo "# 完整模板见 opsget -c all，或仓库 config/env.example.conf"
      echo
    } > "$ENV_FILE"
  fi
  chmod 600 "$ENV_FILE"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      # 分节标题要「粘住」：本节第一个被选中的键前面补上，否则挑着搬的键
      # 会失去归属，文件看起来像一堆散装配置项
      \#*──*) sec="$line"; sec_done=""; buf=""; continue ;;
      ''|\#*)  buf="$buf$line"$'\n'; continue ;;
    esac
    k=${line%%=*}; k=${k#export }; k=${k//[[:space:]]/}
    case "$k" in
      [A-Z_]*) ;;
      *) buf=""; continue ;;
    esac
    # 已有的键连值一起保留 —— 第二次跑 -c 不能把填好的密码冲掉
    if [[ "$want" == *" $k "* ]] \
       && ! grep -qE "^[[:space:]]*(export[[:space:]]+)?$k=" "$ENV_FILE"; then
      if [ -n "$sec" ] && [ -z "$sec_done" ]; then
        printf '\n%s\n' "$sec" >> "$ENV_FILE"; sec_done=1
      fi
      printf '%s%s\n' "$buf" "$line" >> "$ENV_FILE"
      added=$((added+1))
    fi
    buf=""
  done < "$tpl"
  log "[+] $ENV_FILE：新增 $added 项（说明注释一并带过来），已有值未改动"
}

# 云端优先：-e / -c 回答的是「即将拉下来执行的那份脚本要什么」。
# 本地已装副本可能是旧版，旧版少一行声明就会得出「不需要配置」——
# 而这个方向的错答（该拦没拦）比误报缺配置危险得多。
get_env_required() {  # $1=仓库内路径（不带 .sh）
  local p=$1 name tmp keys=""
  valid_path "$p" || die "路径不合法: $p"
  name=$(basename "$p")
  tmp=$(mktemp)
  if curl_retry "$BASE/$p.sh" "$tmp" >/dev/null 2>&1 && [ -s "$tmp" ]; then
    keys=$(env_keys_of "$tmp")
  elif [ -f "$BIN_DIR/$name.sh" ]; then
    log "[警告] 拉取失败，改读本地已装版本 —— 它可能是旧版，声明未必是最新的"
    keys=$(env_keys_of "$BIN_DIR/$name.sh")
  else
    die "拉取失败且本地没有: $p.sh"
  fi
  rm -f "$tmp"
  [ -n "$keys" ] && printf '%s\n' "$keys"
  return 0
}

case "${1:-}" in
  -l|--list)
    log "从 $BASE 拉取清单…"
    curl -fsSL --max-time 60 "$BASE/MANIFEST?_=$(date +%s)" 2>/dev/null \
      || die "仓库里没有 MANIFEST，去 GitHub 页面直接看目录"
    exit 0 ;;

  -c|--config)
    shift
    TPL=$(mktemp)
    curl_retry "$BASE/config/env.example.conf" "$TPL" || { rm -f "$TPL"; die "拉取配置模板失败"; }
    case "${1:-}" in
      all|--all)
        WANT=$(tpl_keys "$TPL")
        log "写入完整模板（所有键）" ;;
      "")
        WANT=$(installed_keys)
        if [ -z "$WANT" ]; then
          rm -f "$TPL"
          log "本机已装的脚本都不需要配置 —— 不用建 env.conf。"
          log "（想看完整模板：opsget -c all）"
          exit 0
        fi
        log "按已装脚本的实际需要补齐" ;;
      *)
        WANT=$(get_env_required "${1%.sh}")
        if [ -z "$WANT" ]; then
          rm -f "$TPL"; log "$1 不需要任何配置，裸机可跑。"; exit 0
        fi
        log "只补 $1 需要的键" ;;
    esac
    WANT=$(env_closure "$TPL" "$WANT")
    env_merge "$TPL" $WANT
    rm -f "$TPL"
    # 追加完还得告诉他哪些是空的 —— 键在文件里但没值，等于没配
    STILL=$(env_missing_keys $WANT | tr '\n' ' ')
    if [ -n "$STILL" ]; then
      log "[!] 待填: $STILL"
      log "    $ENV_FILE（600），填完即可执行"
    else
      log "[✓] 所需的键都已有值"
    fi
    exit 0 ;;

  -e|--env)
    shift
    [ -n "${1:-}" ] || die "用法: opsget -e <路径>"
    KEYS=$(get_env_required "${1%.sh}")
    if [ -z "$KEYS" ]; then log "$1 不需要任何配置，裸机可跑。"; exit 0; fi
    log "$1 需要: $(echo $KEYS)"
    if [ ! -f "$ENV_FILE" ]; then
      log "[缺配置] 还没有 $ENV_FILE —— 跑 opsget -c $1"
      exit 1
    fi
    MISS=$(env_missing_keys $KEYS | tr '\n' ' ')
    if [ -n "$MISS" ]; then log "[缺配置] 待填: $MISS"; log "         补齐: opsget -c $1"; exit 1
    else log "[✓] 都已有值"; fi
    exit 0 ;;

  -u|--update)
    log "[ref] $OPS_REF（$REF_SRC）"
    fetch "bin/opsget" "$BIN_DIR/opsget"
    sync_lib
    log "已更新（ref: $OPS_REF）"
    exit 0 ;;

  -i|--install)
    shift
    [ -n "${1:-}" ] || die "用法: opsget -i <路径>"
    P=${1%.sh}; valid_path "$P" || die "路径不合法: $1"; NAME=$(basename "$P")
    log "[ref] $OPS_REF（$REF_SRC）"
    sync_lib
    fetch "$P.sh" "$BIN_DIR/$NAME.sh"
    log "已安装到 $BIN_DIR/$NAME.sh（未执行）"
    # 只提示不拦截：装完先看一眼要什么，等真执行时才强制
    MISS=$(env_missing "$BIN_DIR/$NAME.sh")
    [ -n "$MISS" ] && log "[提示] 执行前需补配置: $(echo $MISS)（opsget -c $P）"
    exit 0 ;;

  --pin)
    shift
    if [ -z "${1:-}" ]; then
      log "当前 ref: $OPS_REF（$REF_SRC）"
      exit 0
    fi
    NEW=$1
    valid_ref "$NEW" || die "ref 只能含字母、数字和 . _ / -: $NEW"
    [ "$NEW" = main ] && die "main 随每次提交变化，固定它等于没固定；取消固定用 opsget --unpin"
    # 用目标 ref 下的 opsget 做校验：既确认 ref 存在，也确认那一版认得 REF_FILE。
    # 固定到早于 1.4.0 的提交后再 opsget -u，会装回一个不读固定文件的旧引导器，
    # 固定从此悄悄失效、又开始跟 main 走 —— 这里先拦住。
    TMP=$(mktemp) || die "mktemp 失败"
    curl_retry "$OPS_REPO/$NEW/bin/opsget" "$TMP" && [ -s "$TMP" ] \
      || { rm -f "$TMP"; die "仓库里取不到 $NEW（tag 或提交写错了？提交要写完整 40 位）"; }
    grep -q '^REF_FILE=' "$TMP" \
      || { rm -f "$TMP"; die "$NEW 的 opsget 不支持版本固定（早于 1.4.0），固定后 opsget -u 会让固定失效"; }
    rm -f "$TMP"
    mkdir -p "$ENV_DIR"
    printf '%s\n' "$NEW" > "$REF_FILE" && chmod 644 "$REF_FILE" || die "写入 $REF_FILE 失败"
    log "[✓] 已固定到 $NEW（$REF_FILE）"
    log "    再跑 opsget -u，让引导器和 common.sh 也换成这一版"
    [ "$REF_SRC" = "环境变量 OPS_REF" ] && log "[!] 当前 shell 设了 OPS_REF=$OPS_REF，它会覆盖固定，unset 后才生效"
    exit 0 ;;

  --unpin)
    if [ -f "$REF_FILE" ]; then
      OLD=$(head -n1 "$REF_FILE")
      rm -f "$REF_FILE" || die "删除 $REF_FILE 失败"
      log "[✓] 已取消固定（原为 $OLD），之后从 main 拉取"
      [ "$REF_SRC" = "环境变量 OPS_REF" ] && log "[!] 当前 shell 设了 OPS_REF=$OPS_REF，它仍会覆盖默认的 main"
    else
      log "本来就没有固定，当前从 $OPS_REF 拉取（$REF_SRC）"
    fi
    exit 0 ;;

  ""|-h|--help)
    usage
    exit 0 ;;
esac

# ── 拉取并执行 ──────────────────────────────────────────────
P=${1%.sh}; shift
valid_path "$P" || die "路径不合法: $P.sh（写成 目录/脚本名，如 ops/save-fw）"
NAME=$(basename "$P")
log "[ref] $OPS_REF（$REF_SRC）"
sync_lib
fetch "$P.sh" "$BIN_DIR/$NAME.sh"

# 按脚本自己的声明预检。没声明的（init/、vpsscore 等）静默放行 —— 不再假警告。
# 注意这只是提前拦截，脚本运行时的 require_env 照样 die，铁律不变。
MISS=$(env_missing "$BIN_DIR/$NAME.sh")
if [ -n "$MISS" ]; then
  log "[缺配置] $NAME 需要但未填: $(echo $MISS)"
  log "         补齐: opsget -c $P"
  die "配置未就绪，已停止执行（脚本已装好在 $BIN_DIR/$NAME.sh）"
fi

log "──────── 执行 $NAME ────────"
# 导出给子脚本：script-inventory 等要拿本机版本和「同一个 ref 的云端」比对
export OPS_REPO OPS_REF
exec "$BIN_DIR/$NAME.sh" "$@"
