#!/usr/bin/env bash
# bin/opsbox — ops-scripts 中文菜单：按场景挑功能，常用组合自动串联
# VERSION: 1.1.0
# 1.1.0: 缺配置时执行前就地逐项填写（显示模板说明、凭据不回显、原样保存），不再打开编辑器；配置管理可逐项填写与查看；头部提示未填项数；提交号缩短显示。
# 用法: opsbox（或在终端里不带参数运行 opsget）。随 opsget -u 一起更新。

set -o pipefail

OPSBOX_VERSION=1.1.0
BIN_DIR=/usr/local/bin
ENV_FILE=/etc/ops-scripts/env.conf
REF_FILE=/etc/ops-scripts/ref
STATE_DIR=/var/lib/ops-scripts
STATE_FILE="$STATE_DIR/opsbox.state"

die() { printf '[致命] %s\n' "$*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || die "需要 root"
{ [ -t 0 ] && [ -t 1 ]; } || die "菜单需要交互终端；脚本和 cron 里请直接用 opsget <路径> 或本地已装脚本"
command -v opsget >/dev/null 2>&1 || die "找不到 opsget，先按仓库 README 的「快速开始」安装引导器"

# 中文按两列宽对齐，要求 bash 按字符计数；只影响本 shell 的字符串处理
case "$(locale charmap 2>/dev/null)" in
  UTF-8) ;;
  *) locale -a 2>/dev/null | grep -qiE '^c\.utf-?8$' && LC_ALL=C.UTF-8 ;;
esac

c=$(tput colors 2>/dev/null)
if [ -z "${NO_COLOR:-}" ] && [ "${c:-0}" -ge 8 ] 2>/dev/null; then
  R=$'\e[31m' G=$'\e[32m' Y=$'\e[33m' B=$'\e[36m' D=$'\e[2m' H=$'\e[1m' N=$'\e[0m'
else
  R='' G='' Y='' B='' D='' H='' N=''
fi
unset c

# ── 菜单登记表 ──────────────────────────────────────────────
# 分类|键|仓库路径（多个用空格，没有写 -）|标记|标题|什么时候用|会做什么
# 键同时是处理函数名 do_<键>；没有 do_<键> 的单路径项直接经 opsget 执行。
# 按「要办的事」登记，不按脚本登记：改动类脚本只通过带前后检查的联动入口出现。
CATS="check|日常巡检
backup|备份与恢复
security|安全与防火墙
ssh|SSH 密钥
maint|清理与维护
init|服务器初始化
vps|VPS 质量评估
migrate|整机迁移
settings|工具箱设置"

ITEMS=$(cat <<'EOF'
check|daily|-|联动|一键巡检|每周随手跑一次，或感觉哪里不对、不知道从哪查起时|依次跑备份前置检查、证书对账、LLM 访问控制盘点、监控库体检、脚本盘点，最后汇总；本机没配置的项自动跳过
check|preflight|ops/preflight-backup|只读|备份前置检查|改了备份配置、装了新备份脚本，或换机器之后|检查备份依赖的命令、目录、密码文件和网盘配置是否齐全
check|ssl|ops/ssl-audit|只读|证书对账|站点报证书错误、证书快到期，或增删过站点之后|核对证书文件、站点引用、续期记录三方是否一致
check|linkcheck|ops/newapi-linkcheck|需确认|new-api 链路检查|new-api 打不开或变慢，想分清是隧道断了还是公网出了问题|先测隧道端口再测公网地址；隧道不通时会自动重启隧道服务（与定时任务行为相同）
check|komari|ops/komari-metrics-check|只读|监控指标库体检|磁盘涨得快，或每月看一次监控库体积|检查 Komari 指标库的保留期和增长速度
check|panelcron|ops/panel-cron-inspect|只读|面板计划任务|面板里的计划任务看不懂在跑什么，或想手动触发一次时|列出面板计划任务背后的真实命令和运行状态；看完可以挑一个手动触发
check|inventory|ops/script-inventory|只读|本机脚本盘点|想知道本机哪些脚本来自仓库、哪些是手工放的、版本有没有落后|对比本机脚本与固定版本的仓库内容
check|locate|ops/panel-data-locate|只读|定位面板数据|想找某个站点或配置的数据到底存在哪个目录、哪张表|按你给的特征串（如域名）在面板目录和数据库里搜索
backup|health|-|联动|备份体检|每周一次，或担心备份没在跑、云端的包坏了|先跑备份前置检查，再下载云端最新包验证能否解开；校验没通过时自动接着诊断告警邮件
backup|now|backup/vw-fullbackup backup/xboard-fullbackup backup/newapi-fullbackup|需确认|立即备份|升级、迁移或大改之前，先手动备份一次|运行本机已装的备份脚本，和定时任务用同一把锁，不会撞车；不经网络拉取
backup|verify|ops/verify-backup-pass|只读|云端备份包校验|想确认云端的包能用本地密码解开，且最新的包没有过期|每个网盘取最新包下载并解开验证；手动运行不发告警
backup|compare|ops/compare-backup-content|只读|比对最近两个备份包|改了备份脚本后，确认新包内容和旧包一致|解开同一目录下最新的两个包，比较文件清单
backup|panelup|ops/panel-backup-upload|需确认|上传面板整机备份|在面板里手动生成整机备份后，想把它加密传到网盘|先列出本地和云端已有的包，确认后加密上传；可选只保留本机最近上传的几份
security|savefw|ops/save-fw|只读|防火墙快照|手动改 ufw 或 iptables 之前|把当前防火墙规则存到 /root/fwstate_<时间>，并附恢复命令；不改动防火墙
security|llm|ops/check-llm-security ops/sync-llm-allowlist|联动|LLM 访问控制|LLM 站被扫、要加白名单 IP，或改了 ALLOW_EXTRA_IPS 之后|先只读盘点；确认后自动存防火墙快照，同步白名单与 fail2ban，再盘点一次对比
security|bind|ops/bind-localhost|联动|容器端口收回本机|docker ps 看到容器端口是 0.0.0.0:端口、直接暴露在公网时|先生成重建命令给你看；确认后存防火墙快照、重建容器，可选跑端到端验收
security|mail|ops/mail-doctor|只读|告警邮件诊断|收不到告警邮件，或刚配好发信时|检查发信配置与 SMTP 连通性；看完可选实发一封测试邮件
ssh|setupkey|ops/setup-key-login|需确认|新机配置密钥登录|新买的机器只有密码，想改成密钥登录|把本机公钥装到对方并验证能登；密码由脚本静默询问、不留历史；不会关闭密码登录
ssh|pushkeys|ops/push-keys|需确认|批量下发公钥|一次给多台机器下发公钥（需先准备好带密码的清单文件）|按清单逐台下发，已免密的自动跳过；完成后可顺手销毁清单
ssh|diagkey|ops/diag-key|只读|密钥登录诊断|某台机器密钥登不上时|检查对方的目录权限、authorized_keys、sshd 配置和认证过程，只读不改
maint|tidy|ops/cleanup-tidy|需确认|清理冗余文件|磁盘紧张，或脚本更新多次后想清掉旧版和历史输出|先预演列出能清的内容和大小，确认后才删除；备份与容器数据在保护名单里
maint|vwup|ops/upgrade-vaultwarden|联动|Vaultwarden 升级|想看密码库有没有新版本，有就升级|先查新版本；确认升级时自动先做一次新备份，再升级并锁定镜像 digest
maint|logprune|ops/newapi-log-prune|需确认|new-api 日志清理|定时任务每月会跑；数据库太大想提前清一次时|先预演，确认后按保留期清理消费日志（保留期低于 30 天会拒绝）
maint|dbcheck|db/rotate-db-pass|只读|数据库账号核对|应用连不上库，怀疑账号 host 被面板改掉时|列出某个数据库账号的全部 host 记录与授权；只核对，不改密码
init|wizard|init/run init/00-precheck init/01-swap-memory init/02-system-network init/03-ssh-firewall init/04-verify|向导|新机初始化向导|新机器第一次登录后，从这里开始按步骤走|按 00→04 逐步执行并记住进度，需要重启时提示；也可以单独重跑某一阶段
vps|probe|vpsscore/probe|只读|本机质量采集|买了新机器，想知道 CPU、磁盘、线路和 IP 质量|在本机采集硬件与线路指标，结果存成 JSON
vps|collect|vpsscore/collect|只读|多机汇总评分|在汇总机上，想给所有机器统一采集并排名|ssh 到清单里的每台机器收集结果并打分
vps|score|vpsscore/score|只读|按用途排名|只想按用途（中转 / 建站 / 落地）看排名|对已收集的结果按角色权重打分
migrate|migrate|migrate/01-inventory migrate/02-nat-probe migrate/03-pre-migrate migrate/04-verify-migration migrate/05-fix-db-grants migrate/06-export-images migrate/07-restore-containers migrate/08-post-start-check migrate/09-restore-backup-stack ops/restore-cron|向导|整机迁移向导|要把服务整体搬到另一台机器时|先选本机是迁出机还是迁入机，只列出这台该跑的步骤；停服和覆盖数据的步骤要输主机名确认
settings|update|-|需确认|更新工具箱|隔段时间更新一次，或刚发了新版本|按本机固定的版本更新 opsget、公共库和这个菜单
settings|pin|-|需确认|版本固定|发了新 tag 并验证过，要把本机切过去时|查看本机从哪个版本拉取；可固定到新 tag 或取消固定
settings|config|-|需确认|配置管理|脚本提示「缺配置」，或要改 env.conf 时|补齐本机脚本需要的配置键、查看某个脚本需要哪些键、直接编辑 env.conf
settings|crontab|-|需确认|定时任务|想看本机有哪些运维定时任务，或给云端备份校验加上每周任务|列出 crontab 里调用运维脚本的行；可按文档添加每周云端备份校验
settings|purge|ops/cleanup-purge|高危|卸载 ops-scripts|机器不再用这套脚本（交还、转手）时|先预演要删的内容；输主机名确认后删除全部已装脚本和产物，包括这个菜单
EOF
)

# 不进菜单的脚本。CI 据此核对：MANIFEST 里的每个脚本要么登记在上表，要么列在这里。
# MENU-EXCLUDE: ops/decommission-archive      机器退役前只用一次，且刻意不依赖任何公共组件
# MENU-EXCLUDE: ops/apply-newapi-quota-fix    一次性历史数据修复，会停容器、改库
# MENU-EXCLUDE: ops/fix-newapi-fallback-quota 上一项调用的组件，不单独使用
# MENU-EXCLUDE: ops/fix-newapi-quota-data     同上
# MENU-EXCLUDE: ops/deploy-litellm            一次性部署
# MENU-EXCLUDE: ops/containerize-and-pin      一次性改造
# MENU-EXCLUDE: ops/newapi-drill              在备用机上分步演练，菜单里容易误触 teardown
# MENU-EXCLUDE: db/sqlite-dsn                 直接改应用库里的连接串，用得少、误操作代价大
# MENU-EXCLUDE: openclash/dns-anti-poison     在路由器上用 sh 运行，不是服务器脚本

# 场景导航：不知道该用哪个时，从要办的事找到功能。场景|键
SCENES="新买了一台服务器，第一次登录|wizard
想知道一台机器的质量好不好|probe
新机器只有密码，想改成密钥登录|setupkey
某台机器密钥登不上|diagkey
平时随手检查一下|daily
担心备份没在跑，或云端的包坏了|health
升级、迁移、大改之前|now
手动改防火墙之前|savefw
收不到告警邮件|mail
站点证书报错或快过期|ssl
docker 端口暴露在公网|bind
LLM 站被扫，或要加白名单 IP|llm
new-api 打不开|linkcheck
磁盘快满了|tidy
密码库要升级|vwup
应用连不上数据库|dbcheck
脚本提示缺配置|config
要把服务搬到另一台机器|migrate"

# ── 显示 ────────────────────────────────────────────────────
dw() {  # 显示宽度：ASCII 记 1 列，其余（中文）记 2 列
  local s=$1 w=${1//[ -~]/}
  echo $(( ${#s} + ${#w} ))
}
pad() {  # pad <文本> <宽度>：按显示宽度补空格
  local n; n=$(( $2 - $(dw "$1") )); [ "$n" -lt 1 ] && n=1
  printf '%s%*s' "$1" "$n" ''
}
cls() { printf '\e[H\e[2J'; }
hr()  { printf '%s ────────────────────────────────────────────────────%s\n' "$D" "$N"; }
tagc() {
  case "$1" in
    只读)      printf '%s[只读]%s' "$G" "$N" ;;
    需确认)    printf '%s[需确认]%s' "$Y" "$N" ;;
    高危)      printf '%s[高危]%s' "$R" "$N" ;;
    *)         printf '%s[%s]%s' "$B" "$1" "$N" ;;
  esac
}
note() { printf '%s%s%s\n' "$Y" "$*" "$N"; }

# ── 输入 ────────────────────────────────────────────────────
ask() {  # ask <提示> [默认值]；结果放在 ANS
  local p=$1
  [ -n "${2:-}" ] && p="$p [$2]"
  read -r -p "$p: " ANS </dev/tty || ANS=""
  [ -n "$ANS" ] || ANS=${2:-}
}
confirm() {  # confirm <问题> [y|n，默认 n]
  local a def=${2:-n} hint='[y/N]'
  [ "$def" = y ] && hint='[Y/n]'
  read -r -p "$1 $hint " a </dev/tty || a=""
  case "${a:-$def}" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}
gate_host() {  # 高危操作手输主机名：防止在错的机器上顺手回车
  local h a; h=$(hostname)
  printf '\n%s⚠ 高危：%s%s\n' "$R" "$1" "$N"
  read -r -p "  确认在这台机器上执行，请输入主机名 ${H}${h}${N}: " a </dev/tty
  [ "$a" = "$h" ] && return 0
  echo "  主机名不符，已取消"; return 1
}
pause() { local _; read -r -p "${D}回车返回…${N}" _ </dev/tty; }

# ── 配置 ────────────────────────────────────────────────────
env_get() {  # env_get <键>：读 env.conf 里的值（子 shell，不污染菜单）
  ( [ -f "$ENV_FILE" ] && . "$ENV_FILE" >/dev/null 2>&1; printf '%s' "${!1:-}" )
}

keys_missing() {  # keys_missing <声明 token...>：按 env.conf 输出缺的键（A|B 任一有值即可，报首选）
  ( [ -f "$ENV_FILE" ] && . "$ENV_FILE" >/dev/null 2>&1
    for k in "$@"; do
      ok=""
      for a in ${k//|/ }; do [ -n "${!a:-}" ] && { ok=1; break; }; done
      [ -n "$ok" ] || printf '%s ' "${k%%|*}"
    done
    true )
}

# 按本机已装副本的 ENV-REQUIRED 输出缺的键；未安装返回 2。
# 只用来显示状态和执行失败后的引导 —— 执行前的权威预检仍是 opsget 读云端声明。
cfg_missing() {
  local f keys
  f="$BIN_DIR/$(basename "$1").sh"
  [ -f "$f" ] || return 2
  # 不声明键但开头 load_env 的脚本，没有 env.conf 会直接退出（与 opsget 的 needs_env_file 同一判断）
  [ ! -f "$ENV_FILE" ] && grep -qE '^[[:space:]]*load_env([[:space:]]|;|$)' "$f" && printf 'env.conf '
  keys=$(sed -n 's/^#[[:space:]]*ENV-REQUIRED:[[:space:]]*//p' "$f")
  [ -n "$keys" ] || return 0
  # shellcheck disable=SC2086  # 声明是空格分隔的列表
  keys_missing $keys
}

installed_missing() {  # 本机已装的脚本合起来还缺哪些键
  local keys
  keys=$(sed -n 's/^#[[:space:]]*ENV-REQUIRED:[[:space:]]*//p' "$BIN_DIR"/*.sh 2>/dev/null \
         | tr ' ' '\n' | sed '/^$/d' | sort -u)
  [ -n "$keys" ] || return 0
  # shellcheck disable=SC2086
  keys_missing $keys
}

key_help() {  # key_help <键>：env.conf 里这一项上方的说明与行尾注释（opsget -c 从模板一并搬来的）
  [ -f "$ENV_FILE" ] || return 0
  awk -v k="$1" '
    /^[[:space:]]*$/ { n = 0; next }
    /^[[:space:]]*#/ {
      if ($0 ~ /──/) { n = 0; next }
      line = $0; sub(/^[[:space:]]*#[[:space:]]?/, "", line); gsub(/\*\*/, "", line)
      if (line != "") buf[++n] = line
      next
    }
    {
      name = $0; sub(/^[[:space:]]*(export[[:space:]]+)?/, "", name); sub(/=.*/, "", name)
      if (name == k) {
        for (i = 1; i <= n; i++) print buf[i]
        rest = $0; sub(/^[^=]*=/, "", rest)
        if (rest ~ /^"/) sub(/^"[^"]*"/, "", rest); else sub(/^[^[:space:]#]*/, "", rest)
        if (rest ~ /^[[:space:]]*#/) { sub(/^[[:space:]]*#[[:space:]]*/, "", rest); print rest }
        exit
      }
      n = 0
    }' "$ENV_FILE"
}

is_secret() {  # 凭据类：输入不回显，查看时打码
  case "$1" in *_PAT|*TOKEN*|*SECRET*|*_PASS|*_KEY|*HEARTBEAT_URL|*WEBHOOK*) return 0 ;; esac
  return 1
}

ENV_BACKED=""
set_key() {  # set_key <键> <值>：写进 env.conf；用单引号原样保存，不做变量展开
  local tmp line
  if [ -z "$ENV_BACKED" ]; then
    cp -a "$ENV_FILE" "$ENV_FILE.bak.$(date -u +%Y%m%d%H%M%S)" && ENV_BACKED=1
  fi
  line="$1='${2//\'/\'\\\'\'}'"
  tmp=$(mktemp) || return 1
  LINE=$line awk -v k="$1" '
    !done && $0 ~ "^[[:space:]]*(export[[:space:]]+)?" k "=" { print ENVIRON["LINE"]; done = 1; next }
    { print }
    END { if (!done) print ENVIRON["LINE"] }' "$ENV_FILE" > "$tmp" \
    && cat "$tmp" > "$ENV_FILE"   # cat 覆盖：保留原文件的 600 权限
  rm -f "$tmp"
}

fill_key() {  # fill_key <键>：显示说明，读一个值写进 env.conf；回车跳过（返回 1）
  local k=$1 v p help
  printf '\n%s── %s ──%s\n' "$H" "$k" "$N"
  help=$(key_help "$k")
  if [ -n "$help" ]; then printf '%s\n' "$help" | sed 's/^/  /'
  else printf '  %s（没有说明，见仓库 config/env.example.conf）%s\n' "$D" "$N"; fi
  if is_secret "$k"; then
    read -r -s -p "  填写（输入不显示，回车跳过）: " v </dev/tty; echo
  else
    read -r -p "  填写（回车跳过）: " v </dev/tty
  fi
  [ -n "$v" ] || { printf '  %s已跳过%s\n' "$D" "$N"; return 1; }
  set_key "$k" "$v" || { note "  写入 $ENV_FILE 失败"; return 1; }
  printf '  %s✓ 已保存%s\n' "$G" "$N"
  # 路径类填错最常见：不拦，只提醒
  case "$k" in
    *_DIR|*_FILE|*_ROOT|*_DIRS|*_FILES)
      for p in $v; do [ -e "$p" ] || note "  ⚠ $p 现在不存在，确认没写错"; done ;;
  esac
  return 0
}

cfg_later() { printf '%s以后要补：主菜单 9 工具箱设置 → 3 配置管理 → 1 逐项填写%s\n' "$D" "$N"; }

cfg_guide() {  # 执行失败后：若是缺配置，就地逐项带着填。补齐返回 0
  local p=$1 miss left k
  miss=$(cfg_missing "$p")
  [ -n "$miss" ] || return 1
  printf '\n%s这个功能还缺配置：%s%s\n' "$Y" "$miss" "$N"
  if ! confirm "现在逐项填写？（每项都有中文说明，不知道的可以回车跳过）" y; then
    cfg_later; return 1
  fi
  # 建出 env.conf，并把缺的键连同模板里的说明搬进去，下面才有说明可显示
  opsget -c "$p" >/dev/null || return 1
  for k in $miss; do [ "$k" = env.conf ] || fill_key "$k"; done
  left=$(cfg_missing "$p")
  [ -z "$left" ] && { printf '%s✓ 这个功能需要的配置都齐了%s\n' "$G" "$N"; return 0; }
  note "还没填：$left"
  cfg_later
  return 1
}

cfg_fill_all() {  # 已装功能缺的配置一次问完
  local miss k n=0
  opsget -c >/dev/null || return 1
  miss=$(installed_missing)
  if [ -z "$miss" ]; then
    printf '%s✓ 本机已装的功能需要的配置都填好了%s\n' "$G" "$N"
    printf '%s还没用过的功能，第一次执行时缺什么会当场问你%s\n' "$D" "$N"
    return 0
  fi
  for k in $miss; do n=$((n + 1)); done
  printf '本机已装的功能还有 %s 项没填，下面逐项问你；不知道的回车跳过，以后再来\n' "$n"
  for k in $miss; do fill_key "$k"; done
  miss=$(installed_missing)
  if [ -z "$miss" ]; then printf '\n%s✓ 全部填好了%s\n' "$G" "$N"
  else note "还没填：$miss"; fi
}

cfg_show() {  # 列出 env.conf 里的键和值；凭据类只露前 4 位
  [ -f "$ENV_FILE" ] || { note "还没有 $ENV_FILE"; return 1; }
  printf '%s── %s ──%s\n' "$H" "$ENV_FILE" "$N"
  ( . "$ENV_FILE" >/dev/null 2>&1
    grep -oE '^[[:space:]]*(export[[:space:]]+)?[A-Z_][A-Z0-9_]*=' "$ENV_FILE" \
      | sed -E 's/^[[:space:]]*(export[[:space:]]+)?//; s/=$//' | awk '!seen[$0]++' \
      | while read -r k; do
          v=${!k:-}
          if [ -z "$v" ]; then printf '  %s  %s（空）%s\n' "$(pad "$k" 26)" "$D" "$N"
          elif is_secret "$k"; then printf '  %s  %s***\n' "$(pad "$k" 26)" "${v:0:4}"
          else printf '  %s  %s\n' "$(pad "$k" 26)" "$v"; fi
        done )
}

edit_env() {
  local ed=${EDITOR:-}
  if [ -z "$ed" ]; then
    for ed in nano vim vi; do command -v "$ed" >/dev/null 2>&1 && break; done
  fi
  confirm "用 $ed 打开 $ENV_FILE？" y && "$ed" "$ENV_FILE"
}

# ── 执行 ────────────────────────────────────────────────────
report_rc() {  # report_rc <退出码> <开始时间>
  local s=$(( $(date +%s) - $2 ))
  if [ "$1" -eq 0 ]; then
    printf '%s✓ 完成%s（%ss）\n' "$G" "$N" "$s"
  else
    printf '%s✗ 退出码 %s%s（%ss）—— 有告警或失败，看上面的输出\n' "$Y" "$1" "$N" "$s"
  fi
}

run_ops() {  # run_ops <仓库路径> [参数...]：经 opsget 执行（遵守版本固定），缺配置时引导补齐后可重跑
  local p=$1 t0 rc; shift
  # 先装好（不执行）再看缺不缺配置：缺就当场逐项问，填完直接执行，
  # 不让人先看一屏「[致命] 配置未就绪」再被问要不要重来。装不上（网络）就照常执行，交给 opsget 报错
  if opsget -i "$p" >/dev/null 2>&1 && [ -n "$(cfg_missing "$p")" ]; then
    cfg_guide "$p" || return 1
  fi
  while :; do
    printf '\n%s▶ opsget %s%s\n' "$B" "$p${*:+ $*}" "$N"
    t0=$(date +%s)
    opsget "$p" "$@"; rc=$?
    report_rc "$rc" "$t0"
    if [ "$rc" -ne 0 ] && cfg_guide "$p" && confirm "配置已补齐，重新执行？" y; then
      continue
    fi
    return "$rc"
  done
}

cron_lock() {  # cron_lock <脚本文件名>：crontab 里给它用的 flock 锁文件
  crontab -l 2>/dev/null | grep -vE '^[[:space:]]*#' | grep -F "/$1" | head -1 | awk '{
    for (i = 1; i <= NF; i++) if ($i ~ /(^|\/)flock$/) {
      for (j = i + 1; j <= NF; j++) {
        if ($j ~ /^-/) { if ($j ~ /^(-w|-E|--wait|--timeout|--conflict-exit-code)$/) j++; continue }
        print $j; exit
      }
    }
  }'
}

backup_run() {  # backup_run <脚本名>：跑本地已装的备份，和 cron 同一把锁；不经 opsget
  local n=$1 f="$BIN_DIR/$1.sh" lock t0 rc
  [ -x "$f" ] || { note "本机没装 $n（opsget -i backup/$n）"; return 1; }
  lock=$(cron_lock "$n.sh")
  if [ -z "$lock" ]; then
    lock="/var/lock/$n.lock"
    note "crontab 里没找到 $n 的定时任务，改用 $lock（这台机器可能没有定时备份）"
  fi
  printf '\n%s▶ flock -n %s %s%s  %s(%s)%s\n' "$B" "$lock" "$f" "$N" "$D" \
    "$(sed -n 's/^# VERSION: /本地版本 /p' "$f" | head -1)" "$N"
  t0=$(date +%s)
  flock -n -E 75 "$lock" "$f"; rc=$?
  [ "$rc" -eq 75 ] && note "锁被占用：定时备份可能正在跑，等它结束再试"
  report_rc "$rc" "$t0"
  return "$rc"
}

# 联动：每步记一行「结果<TAB>步骤<TAB>耗时」，最后汇总。
# 退出码分不清「有告警」和「失败」（common.sh 的 finish 与 die 都是 1），
# 所以只读的检查一律接着跑，改动前由各流程显式确认。
flow_begin() { FLOW_NAME=$1; FLOW_LOG=""; printf '\n%s════ %s ════%s\n' "$H" "$1" "$N"; }
flow_rec()   { FLOW_LOG+="$1"$'\t'"$2"$'\t'"$3"$'\n'; }
step() {  # step <步骤名> <命令...>
  local name=$1 t0 rc; shift
  t0=$(date +%s)
  "$@"; rc=$?
  if [ "$rc" -eq 0 ]; then flow_rec 通过 "$name" "$(( $(date +%s) - t0 ))s"
  else flow_rec "异常 $rc" "$name" "$(( $(date +%s) - t0 ))s"; fi
  return "$rc"
}
check_step() {  # check_step <步骤名> <仓库路径>：互不依赖的检查，本机没配置就跳过
  if ! opsget -e "$2" >/dev/null 2>&1; then
    printf '\n%s- %s：本机未配置，跳过%s\n' "$D" "$1" "$N"
    flow_rec 未配置 "$1" -
    return 0
  fi
  step "$1" run_ops "$2"
}
flow_end() {
  local r n s col
  printf '\n%s──── %s · 汇总 ────%s\n' "$H" "$FLOW_NAME" "$N"
  while IFS=$'\t' read -r r n s; do
    [ -n "$n" ] || continue
    case "$r" in 通过) col=$G ;; 未配置|未执行|跳过) col=$D ;; *) col=$Y ;; esac
    printf '  %s%s%s %s %s\n' "$col" "$(pad "$r" 8)" "$N" "$(pad "$n" 26)" "$s"
  done <<<"$FLOW_LOG"
}

fw_snapshot() {  # 改防火墙前自动存一份现状。新机还没有 env.conf 时 save-fw 跑不了，跳过
  if [ ! -f "$ENV_FILE" ]; then
    printf '%s（还没有 env.conf，跳过防火墙快照）%s\n' "$D" "$N"
    flow_rec 跳过 防火墙快照 -
    return 0
  fi
  step "防火墙快照" run_ops ops/save-fw && return 0
  confirm "防火墙快照没存成，仍然继续？" n
}

# ── 功能：日常巡检 ──────────────────────────────────────────
do_daily() {
  flow_begin "一键巡检"
  check_step "备份前置检查" ops/preflight-backup
  check_step "证书对账" ops/ssl-audit
  check_step "LLM 访问控制盘点" ops/check-llm-security
  check_step "监控指标库体检" ops/komari-metrics-check
  check_step "本机脚本盘点" ops/script-inventory
  flow_end
  if [[ "$FLOW_LOG" == *未配置* ]]; then
    printf '\n%s标「未配置」的项被跳过了。要启用哪一项，就在「日常巡检」里单独选它执行，缺的配置会当场逐项问你。%s\n' "$D" "$N"
  fi
}

