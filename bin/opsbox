}

# ── 功能：SSH 密钥 ──────────────────────────────────────────
do_setupkey() {
  local ip port user args
  ask "新机器 IP"; ip=$ANS
  [[ "$ip" =~ ^[A-Za-z0-9.:-]+$ ]] || { note "IP 不合法：$ip"; return 1; }
  ask "SSH 端口" 22; port=$ANS
  [[ "$port" =~ ^[0-9]+$ ]] || { note "端口不合法：$port"; return 1; }
  ask "登录用户" root; user=$ANS
  [[ "$user" =~ ^[A-Za-z0-9._-]+$ ]] || { note "用户名不合法：$user"; return 1; }
  args=("$ip" "$port")
  [ "$user" = root ] || args+=(--user "$user")
  printf '%s密码稍后由脚本静默询问（不回显、不进历史）%s\n' "$D" "$N"
  run_ops ops/setup-key-login "${args[@]}"
}

do_pushkeys() {
  ask "主机清单文件" /root/.vps-keyinit.txt
  if [ ! -f "$ANS" ]; then
    note "清单不存在：$ANS"
    printf '  每行一台：ssh目标[:端口] 空格 密码，例如\n    root@1.2.3.4:22  MyPassw0rd\n  权限必须是 600（chmod 600 %s）\n' "$ANS"
    return 1
  fi
  local list=$ANS
  run_ops ops/push-keys "$list"
  echo
  note "清单里是明文密码，下发完应销毁。"
  confirm "现在销毁 $list（shred -u，不可恢复）？" n && shred -u "$list" && echo "已销毁"
}

do_diagkey() {
  local t
  ask "目标（ssh 别名，或 root@1.2.3.4:22）"; t=$ANS
  [[ "$t" =~ ^[A-Za-z0-9@._:-]+$ ]] || { note "目标不合法：$t"; return 1; }
  if confirm "密钥完全登不上，需要改用密码登录进去查？" n; then
    run_ops ops/diag-key "$t" -p
  else
    run_ops ops/diag-key "$t"
  fi
}

# ── 功能：清理与维护 ────────────────────────────────────────
do_tidy() {
  run_ops ops/cleanup-tidy
  echo
  confirm "按上面的预演执行清理？" n && run_ops ops/cleanup-tidy --apply
}

vw_backup_age() {  # 本机最新 Vaultwarden 备份包距今几小时；没有则无输出
  local d f
  d=$(env_get VW_BACKUP_DIR)
  [ -n "$d" ] || return 0
  # shellcheck disable=SC2012  # 文件名由备份脚本生成，不含换行
  f=$(ls -t "$d"/srvbak_*.7z 2>/dev/null | head -1)
  [ -n "$f" ] && echo $(( ($(date +%s) - $(stat -c %Y "$f")) / 3600 ))
}

do_vwup() {
  local age
  flow_begin "Vaultwarden 升级"
  step "查询新版本" run_ops ops/upgrade-vaultwarden
  echo
  if ! confirm "上面显示有新版本、现在升级？" n; then
    flow_rec 未执行 升级 -; flow_end; return 0
  fi
  age=$(vw_backup_age)
  if [ -n "$age" ]; then echo "  本机最新备份：${age} 小时前（升级脚本要求 24 小时内）"
  else note "  本机没找到备份包"; fi
  if confirm "升级前先做一次新备份？（推荐：数据库迁移没法随 compose 回滚）" y; then
    if ! step "升级前备份" backup_run vw-fullbackup; then
      confirm "备份没成功，仍然升级？" n || { flow_rec 未执行 升级 -; flow_end; return 1; }
    fi
  fi
  step "升级" run_ops ops/upgrade-vaultwarden -y
  flow_end
}

