  run_ops ops/newapi-log-prune --dry-run
  echo
  confirm "按保留期真正清理？" n && run_ops ops/newapi-log-prune
}

do_dbcheck() {
  ask "数据库用户名"
  [[ "$ANS" =~ ^[A-Za-z0-9_.-]+$ ]] || { note "用户名不合法：$ANS"; return 1; }
  run_ops db/rotate-db-pass check "$ANS"
}

# ── 功能：服务器初始化 ──────────────────────────────────────
INIT_STAGES="00|环境探测与更新
01|Swap 与内存参数
02|系统与网络调优
03|SSH 加固与防火墙
04|重启后持久性验证"

state_get() { [ -f "$STATE_FILE" ] && sed -n "s/^$1=//p" "$STATE_FILE" | tail -1; }
state_set() {  # state_set <键> <值>；值为空即删除该键
  local tmp
  mkdir -p "$STATE_DIR"
  tmp=$(mktemp) || return 1
  [ -f "$STATE_FILE" ] && grep -v "^$1=" "$STATE_FILE" > "$tmp"
  [ -n "$2" ] && printf '%s=%s\n' "$1" "$2" >> "$tmp"
  mv "$tmp" "$STATE_FILE" && chmod 644 "$STATE_FILE"
}
boot_id() { cat /proc/sys/kernel/random/boot_id 2>/dev/null; }

init_next() {  # 第一个还没完成的阶段；全部完成则无输出
  local fin n _
  fin=" $(state_get INIT_DONE) "
  while IFS='|' read -r n _; do
    [[ "$fin" == *" $n "* ]] || { echo "$n"; return; }
  done <<<"$INIT_STAGES"
}

need_reboot() {
  note "⚠ $1。重启后重新登录，运行 opsbox 会从下一步接着走。"
  state_set INIT_BOOT "$(boot_id)"
  confirm "现在重启？" n && { sync; reboot; }
}

init_stage() {  # init_stage <阶段号>
  local n=$1 fin
  if [ "$n" = 03 ]; then
    gate_host "阶段 03 会改 SSH 与防火墙，配错会把自己锁在外面" || return 1
    fw_snapshot || return 1
  fi
  run_ops init/run "$n" || return
  fin=$(state_get INIT_DONE)
  [[ " $fin " == *" $n "* ]] || state_set INIT_DONE "${fin:+$fin }$n"
  case "$n" in
    00) [ -f /var/run/reboot-required ] && need_reboot "系统更新要求重启" ;;
    03) need_reboot "阶段 03 之后要重启一次，再用 04 验证配置开机后仍然生效" ;;
    04) printf '%s✓ 初始化全部完成%s\n' "$G" "$N"; state_set INIT_DONE ""; state_set INIT_BOOT "" ;;
  esac
  return 0
}

do_wizard() {
  local fin next n t sel
  while :; do
    cls
    printf '%s── 新机初始化向导 ──%s\n\n' "$H" "$N"
    fin=" $(state_get INIT_DONE) "; next=$(init_next)
    while IFS='|' read -r n t; do
      if [[ "$fin" == *" $n "* ]]; then
        printf '  [%s] %s%s✓ 已完成%s\n' "$n" "$(pad "$t" 20)" "$G" "$N"
      elif [ "$n" = "$next" ]; then
        printf '  [%s] %s%s← 下一步%s\n' "$n" "$(pad "$t" 20)" "$B" "$N"
      else
        printf '  [%s] %s\n' "$n" "$t"
      fi
    done <<<"$INIT_STAGES"
    echo
    [ -n "$(state_get INIT_BOOT)" ] && [ "$(state_get INIT_BOOT)" = "$(boot_id)" ] \
      && note "  ⚠ 上一步要求重启，还没有重启"
    printf '  顺序：00 →(需要则重启)→ 01 → 02 → 03 →(重启)→ 04\n'
    printf '  %s阶段 03 之前：先另开一个 SSH 窗口连着，并确认带外控制台（VNC）能进%s\n\n' "$Y" "$N"
    printf '  回车 执行下一步%s   输入编号 单独执行该阶段   r 重置进度   0 返回\n' "${next:+ $next}"
    read -r -p "请选择 > " sel </dev/tty || return
    case "$sel" in
      0|q) return ;;
      r)   state_set INIT_DONE ""; state_set INIT_BOOT ""; continue ;;
      '')  [ -n "$next" ] || { note "所有阶段都已完成；要重跑请输入编号"; pause; continue; }
           sel=$next ;;
    esac
    [[ "$sel" =~ ^0?[0-4]$ ]] || continue
    sel=$(printf '%02d' "$((10#$sel))")
    init_stage "$sel"
    pause
  done
}

# ── 功能：VPS 质量评估 ──────────────────────────────────────
do_probe() {
  printf '  [1] 快速（约 1 分钟，跳过耗时的测试）\n  [2] 完整\n  [3] 完整 + IP 质量深度检测（再加 1-2 分钟）\n'
  ask "选择" 1
  case "$ANS" in
    1) run_ops vpsscore/probe --quick ;;
    2) run_ops vpsscore/probe ;;
    3) run_ops vpsscore/probe --ipq ;;
  esac
}

do_collect() {
  printf '  [1] 汇总各机已有的结果并打分\n  [2] 每台重新采集后打分（约 1-2 分钟/台）\n'
  printf '  [3] 重新采集 + IP 质量深度检测\n  [4] 只列出会连接哪些主机，不实际连接\n'
  ask "选择" 1
  case "$ANS" in
    1) run_ops vpsscore/collect ;;
    2) run_ops vpsscore/collect -p ;;
    3) run_ops vpsscore/collect -p --ipq ;;
    4) run_ops vpsscore/collect -n ;;
  esac
}

do_score() {
  local dir
  ask "结果目录" "$HOME/vpsscore-baseline"; dir=$ANS
  [ -e "$dir" ] || { note "不存在：$dir（先跑「多机汇总评分」或「本机质量采集」）"; return 1; }
  printf '  [1] 全部角色\n  [2] relay 中转   看重带宽、丢包\n  [3] web 建站     看重 CPU、磁盘\n  [4] land 落地    看重直连延迟\n'
  ask "选择" 1
  case "$ANS" in
    2) run_ops vpsscore/score -r relay "$dir" ;;
    3) run_ops vpsscore/score -r web "$dir" ;;
    4) run_ops vpsscore/score -r land "$dir" ;;
    *) run_ops vpsscore/score "$dir" ;;
  esac
}

# ── 功能：整机迁移 ──────────────────────────────────────────
MIG_OUT="01|环境摸底（新旧两台都要跑，输出拿去对比）
02|入站探测：从本机探测迁入机的端口（迁入机先开监听）
03|冷快照：停服并全量导出（执行后服务保持停止）
04|迁移比对（新旧两台都要跑，输出拿去 diff）
06|导出容器镜像（迁入机不要重新 pull）"
MIG_IN="01|环境摸底（新旧两台都要跑，输出拿去对比）
02|入站监听：等迁出机来探测本机端口
04|迁移比对（新旧两台都要跑，输出拿去 diff）
05|修正数据库账号 host
07|恢复容器数据并生成启动命令（会覆盖本机数据目录）
08|端到端验收（切 DNS 之前预演）
09|重建备份体系
cron|恢复定时任务（业务切换并观察正常后再做）"

mig_run() {  # mig_run <角色 out|in> <步骤>
  local snap
  case "$1:$2" in
    *:01)    run_ops migrate/01-inventory ;;
    out:02)  ask "迁入机 IP" "$(env_get NEW_HOST_IP)"
             [ -n "$ANS" ] || { note "需要迁入机 IP"; return 1; }
             run_ops migrate/02-nat-probe probe "$ANS" ;;
    in:02)   run_ops migrate/02-nat-probe listen ;;
    out:03)  gate_host "停掉本机所有服务并制作冷快照，结束后服务保持停止" \
               && run_ops migrate/03-pre-migrate ;;
    *:04)    run_ops migrate/04-verify-migration ;;
    in:05)   confirm "修正数据库账号的 host 授权？" n && run_ops migrate/05-fix-db-grants ;;
    out:06)  run_ops migrate/06-export-images ;;
    in:07)   ask "快照目录（回车=最新的 premigrate_*）"
             snap=$ANS
             gate_host "用快照覆盖本机的容器数据目录" || return 1
             if [ -n "$snap" ]; then run_ops migrate/07-restore-containers "$snap"
             else run_ops migrate/07-restore-containers; fi ;;
    in:08)   run_ops migrate/08-post-start-check ;;
    in:09)   ask "恢复暂存目录" /root/restore_stage
             confirm "从 $ANS 重建备份依赖和配置？" n && run_ops migrate/09-restore-backup-stack "$ANS" ;;
    in:cron) confirm "业务已经切换过来并观察正常了？" n && run_ops ops/restore-cron ;;
    *)       return 1 ;;
  esac
}

do_migrate() {
  local role steps n t sel
  role=$(state_get MIG_ROLE)
  while :; do
    if [ -z "$role" ]; then
      cls
      printf '%s── 整机迁移向导 ──%s\n\n  这台机器是？\n  [1] 迁出机（旧机器）\n  [2] 迁入机（新机器）\n  [0] 返回\n' "$H" "$N"
      ask "选择"
      case "$ANS" in 1) role=out ;; 2) role=in ;; *) return ;; esac
      state_set MIG_ROLE "$role"
    fi
    cls
    if [ "$role" = out ]; then steps=$MIG_OUT; t="迁出机（旧机器）"; else steps=$MIG_IN; t="迁入机（新机器）"; fi
    printf '%s── 整机迁移向导 · 本机是%s ──%s\n\n' "$H" "$t" "$N"
    while IFS='|' read -r n t; do printf '  [%s] %s\n' "$n" "$t"; done <<<"$steps"
    printf '\n  %s按编号从小到大做；每一步的执行机器和产物见 migrate/README.md%s\n' "$D" "$N"
    printf '  输入编号执行   c 切换角色   0 返回\n'
    read -r -p "请选择 > " sel </dev/tty || return
    case "$sel" in
      0|q|'') return ;;
      c)      role=""; state_set MIG_ROLE ""; continue ;;
      cron)   ;;
      *)      [[ "$sel" =~ ^[0-9]+$ ]] || continue
              sel=$(printf '%02d' "$((10#$sel))") ;;
    esac
    grep -q "^$sel|" <<<"$steps" || continue
    mig_run "$role" "$sel"
    pause
  done
}

# ── 功能：工具箱设置 ────────────────────────────────────────
do_update() {
  local before after
  before=$(cksum < "$BIN_DIR/opsbox" 2>/dev/null)
  opsget -u || return
  after=$(cksum < "$BIN_DIR/opsbox" 2>/dev/null)
  if [ -n "$after" ] && [ "$before" != "$after" ]; then
    note "菜单本身也更新了，重新载入…"; sleep 1
    exec "$BIN_DIR/opsbox"
  fi
}

do_pin() {
  opsget --pin
  printf '\n  [1] 固定到新的 tag\n  [2] 取消固定（回到 main）\n  [0] 返回\n'
  ask "选择" 0
  case "$ANS" in
    1) ask "tag（如 v2026.09.25）"
       [ -n "$ANS" ] || return 0
       opsget --pin "$ANS" || return
       confirm "接着把引导器、公共库和菜单换成这一版（opsget -u）？" y && do_update ;;
    2) note "生产机应保持固定：取消后，下次更新会装上 main 上还没验证过的提交。"
       confirm "确定取消固定？" n && opsget --unpin ;;
  esac
}

do_config() {
  printf '  [1] 逐项填写本机还没填的配置（推荐：每项有中文说明，回车可跳过）\n'
  printf '  [2] 查看当前配置（密码类只显示前几位）\n'
  printf '  [3] 查看某个脚本需要哪些配置\n'
  printf '  [4] 用编辑器打开 env.conf（高级）\n  [0] 返回\n'
  ask "选择" 1
  case "$ANS" in
    1) cfg_fill_all ;;
    2) cfg_show ;;
    3) ask "脚本路径（如 ops/ssl-audit）"
       [ -n "$ANS" ] && opsget -e "$ANS" ;;
    4) [ -f "$ENV_FILE" ] || { note "还没有 $ENV_FILE，先选 1"; return 1; }
       edit_env ;;
  esac
}

do_crontab() {
  local line
  printf '%s── root 的 crontab 里调用运维脚本的行 ──%s\n' "$H" "$N"
  crontab -l 2>/dev/null | grep -vE '^[[:space:]]*(#|$)' | grep -E "$BIN_DIR/[A-Za-z0-9_-]+\.sh" \
    | sed 's/^/  /' || echo "  （没有）"
  printf '\n  %s提醒：定时任务只调用本地已装的脚本，不要写 opsget（见仓库 README）%s\n' "$D" "$N"
  # 与 ops/README.md「云端备份每周校验」给出的那一行保持一致
  line='0 6 * * 1 /usr/bin/flock -n /run/verify-backup-pass.lock /usr/local/bin/verify-backup-pass.sh --cron >> /var/log/verify-backup-pass.log 2>&1'
  if [ -x "$BIN_DIR/verify-backup-pass.sh" ] && ! crontab -l 2>/dev/null | grep -q 'verify-backup-pass\.sh'; then
    printf '\n  推荐添加：每周一 06:00（UTC）校验云端备份包\n    %s\n' "$line"
    if confirm "添加到 root 的 crontab？" n; then
      { crontab -l 2>/dev/null; printf '%s\n' "$line"; } | crontab - && echo "  已添加"
    fi
  fi
}

do_purge() {
  run_ops ops/cleanup-purge
  gate_host "删除本机全部 ops-scripts 脚本与产物，包括这个菜单" || return 1
  run_ops ops/cleanup-purge --apply
  [ -x "$BIN_DIR/opsbox" ] || { echo "菜单已随之移除，退出。"; exit 0; }
}

# ── 菜单 ────────────────────────────────────────────────────
load_item() {  # load_item <键> → I_PATHS I_TAG I_TITLE I_WHEN I_WHAT
  local line
  line=$(awk -F'|' -v k="$1" '$2 == k { print; exit }' <<<"$ITEMS")
  [ -n "$line" ] || return 1
  IFS='|' read -r _ _ I_PATHS I_TAG I_TITLE I_WHEN I_WHAT <<<"$line"
}

cfg_badge() {  # 单路径项在本机缺配置时显示标记
  local m
  case "$1" in -|*' '*) return ;; esac
  m=$(cfg_missing "$1")
  [ -n "$m" ] && printf ' %s[未配置]%s' "$Y" "$N"
}

open_item() {  # 先给说明卡片，再执行
  local a
  load_item "$1" || return
  cls
  printf '%s── %s ──%s  %s\n\n' "$H" "$I_TITLE" "$N" "$(tagc "$I_TAG")"
  printf '  %s%s%s%s\n' "$D" "$(pad 什么时候用 12)" "$N" "$I_WHEN"
  printf '  %s%s%s%s\n' "$D" "$(pad 会做什么 12)" "$N" "$I_WHAT"
  case "$I_PATHS" in
    -|*' '*) ;;
    *) declare -F "do_$1" >/dev/null || printf '  %s%s%sopsget %s\n' "$D" "$(pad 等价命令 12)" "$N" "$I_PATHS"
       a=$(cfg_missing "$I_PATHS")
       [ -n "$a" ] && printf '  %s%s%s缺 %s（执行时会引导补齐）%s\n' "$D" "$(pad 本机配置 12)" "$N$Y" "$a" "$N" ;;
  esac
  echo
  read -r -p "回车开始，0 返回 > " a </dev/tty || return
  case "$a" in 0|q) return ;; esac
  if declare -F "do_$1" >/dev/null; then "do_$1"; else run_ops "$I_PATHS"; fi
  echo
  pause
}

cat_menu() {  # cat_menu <分类ID> <分类名>
  local keys k i sel
  mapfile -t keys < <(awk -F'|' -v c="$1" '$1 == c { print $2 }' <<<"$ITEMS")
  # 只有一项的分类（向导）直接进去
  [ ${#keys[@]} -eq 1 ] && { open_item "${keys[0]}"; return; }
  while :; do
    cls
    printf '%s── %s ──%s\n\n' "$H" "$2" "$N"
    i=0
    for k in "${keys[@]}"; do
      i=$((i + 1)); load_item "$k"
      printf '  %s[%d]%s %s%s%s\n' "$H" "$i" "$N" "$(pad "$I_TITLE" 22)" "$(tagc "$I_TAG")" "$(cfg_badge "$I_PATHS")"
      printf '      %s%s%s\n' "$D" "$I_WHEN" "$N"
    done
    printf '\n  [0] 返回\n'
    read -r -p "请选择 > " sel </dev/tty || return
    case "$sel" in 0|'') return ;; q) exit 0 ;; esac
    [[ "$sel" =~ ^[0-9]+$ ]] && [ "$sel" -ge 1 ] && [ "$sel" -le ${#keys[@]} ] \
      && open_item "${keys[sel-1]}"
  done
}

scene_menu() {
  local keys=() s k i=0 sel
  while :; do
    cls
    printf '%s── 不知道用哪个？按要办的事找 ──%s\n\n' "$H" "$N"
    keys=(); i=0
    while IFS='|' read -r s k; do
      i=$((i + 1)); keys+=("$k"); load_item "$k"
      printf '  %s%s%s %s %s→ %s%s\n' "$H" "$(pad "[$i]" 5)" "$N" "$(pad "$s" 34)" "$D" "$I_TITLE" "$N"
    done <<<"$SCENES"
    printf '\n  [0] 返回\n'
    read -r -p "请选择 > " sel </dev/tty || return
    case "$sel" in 0|'') return ;; q) exit 0 ;; esac
    [[ "$sel" =~ ^[0-9]+$ ]] && [ "$sel" -ge 1 ] && [ "$sel" -le ${#keys[@]} ] \
      && open_item "${keys[sel-1]}"
  done
}

short_ref() {  # 40 位提交号只显示前 12 位，tag 原样
  if [[ "$1" =~ ^[0-9a-f]{40}$ ]]; then printf '%s…' "${1:0:12}"; else printf '%s' "$1"; fi
}

banner() {
  local ref ov os up mem envs next ib miss
  printf '%s' "$B"
  printf '%s\n' \
    '    ___  ____  ____     ____   _____  __' \
    '   / _ \|  _ \/ ___|   | __ ) / _ \ \/ /' \
    "  | | | | |_) \\___ \\   |  _ \\| | | \\  /     ${N}${H}运维工具箱${N}${B}" \
    "  | |_| |  __/ ___) |  | |_) | |_| /  \\     ${N}${D}opsbox ${OPSBOX_VERSION}${N}${B}" \
    '   \___/|_|   |____/   |____/ \___/_/\_\'
  printf '%s' "$N"
  hr
  if [ -n "${OPS_REF:-}" ]; then ref="$(short_ref "$OPS_REF")（环境变量覆盖）"
  elif [ -s "$REF_FILE" ]; then ref="$(short_ref "$(head -n1 "$REF_FILE")")（已固定）"
  else ref="${Y}main（未固定）${N}"; fi
  ov=$(sed -n 's/^# VERSION: //p' "$(command -v opsget)" 2>/dev/null | head -1)
  os=$( . /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-未知}")
  up=$(awk '{ d = int($1 / 86400); h = int($1 % 86400 / 3600); if (d) printf "%d 天 %d 小时", d, h; else printf "%d 小时", h }' /proc/uptime 2>/dev/null)
  mem=$(free 2>/dev/null | awk '/^Mem:/ { if ($2) printf "%d%%", ($2 - $7) * 100 / $2 }')
  printf '  主机  %s    系统  %s\n' "$(hostname)" "$os"
  printf '  版本  %s    opsget %s\n' "$ref" "${ov:-?}"
  printf '  负载  %s    磁盘 / %s    内存 %s    已运行 %s\n' \
    "$(cut -d' ' -f1 /proc/loadavg 2>/dev/null)" "$(df -P / 2>/dev/null | awk 'NR == 2 { print $5 }')" \
    "${mem:-?}" "${up:-?}"
  miss=$(installed_missing)
  if [ -n "$miss" ]; then
    # shellcheck disable=SC2086  # 数一下有几项
    set -- $miss
    envs="${Y}已装的功能还有 $# 项配置没填 → 9 工具箱设置 → 3 配置管理${N}"
  elif [ -f "$ENV_FILE" ]; then
    envs="${G}env.conf ✓${N}"
    [ "$(stat -c %a "$ENV_FILE" 2>/dev/null)" = 600 ] || envs="${Y}env.conf 权限不是 600${N}"
  else
    envs="${D}还没有 env.conf（用到哪个功能缺什么，会当场逐项问你）${N}"
  fi
  printf '  配置  %s\n' "$envs"
  [ -f /var/run/reboot-required ] && printf '  %s⚠ 系统标记需要重启%s\n' "$Y" "$N"
  systemctl list-timers --all 2>/dev/null | grep -qi rollback \
    && printf '  %s⚠ 存在遗留的回滚定时器：systemctl stop server-rollback.timer%s\n' "$Y" "$N"
  # 初始化进度：重启过就清掉「待重启」标记
  ib=$(state_get INIT_BOOT)
  [ -n "$ib" ] && [ "$ib" != "$(boot_id)" ] && { state_set INIT_BOOT ""; ib=""; }
  if [ -n "$(state_get INIT_DONE)" ]; then
    next=$(init_next)
    [ -n "$next" ] && printf '  %s▸ 初始化进行中：下一步 %s%s%s（服务器初始化 → 向导）\n' \
      "$B" "$next" "${ib:+，需先重启}" "$N"
  fi
  hr
}

main_menu() {
  local sel ids=() names=() id name i left
  while IFS='|' read -r id name; do ids+=("$id"); names+=("$name"); done <<<"$CATS"
  while :; do
    cls
    banner
    for ((i = 0; i < 5; i++)); do
      left="[$((i + 1))] ${names[i]}"
      if [ -n "${names[i + 5]:-}" ]; then
        printf '  %s[%d] %s\n' "$(pad "$left" 26)" $((i + 6)) "${names[i + 5]}"
      else
        printf '  %s\n' "$left"
      fi
    done
    printf '\n  %s[a]%s 一键巡检    %s[b]%s 备份体检    %s[?]%s 不知道用哪个？按场景找\n' \
      "$B" "$N" "$B" "$N" "$B" "$N"
    printf '  [q] 退出\n\n'
    read -r -p "请选择 > " sel </dev/tty || exit 0
    case "$sel" in
      q|Q|0) exit 0 ;;
      a) open_item daily ;;
      b) open_item health ;;
      \?|？) scene_menu ;;
      [1-9]) [ "$sel" -le ${#ids[@]} ] && cat_menu "${ids[sel-1]}" "${names[sel-1]}" ;;
    esac
  done
}

main_menu
