  run_ops ops/panel-cron-inspect
  echo
  ask "要手动触发其中一个任务吗？输入它的 hash（回车跳过）"
  [ -n "$ANS" ] || return 0
  [[ "$ANS" =~ ^[A-Za-z0-9]+$ ]] || { note "hash 只含字母和数字：$ANS"; return 1; }
  confirm "立即执行这个计划任务？" n && run_ops ops/panel-cron-inspect --run "$ANS"
}

do_locate() {
  ask "特征串（域名、库名等；回车=用配置里的第一个域名）"
  if [ -n "$ANS" ]; then run_ops ops/panel-data-locate "$ANS"; else run_ops ops/panel-data-locate; fi
}

# ── 功能：备份与恢复 ────────────────────────────────────────
do_health() {
  flow_begin "备份体检"
  step "备份前置检查" run_ops ops/preflight-backup
  if ! step "云端备份包校验" run_ops ops/verify-backup-pass; then
    note "云端校验没通过。备份出问题时靠告警邮件通知你，接着确认邮件链路…"
    step "告警邮件诊断" run_ops ops/mail-doctor
  fi
  flow_end
}

do_now() {
  local opts=() n i
  for n in vw-fullbackup xboard-fullbackup newapi-fullbackup; do
    [ -x "$BIN_DIR/$n.sh" ] && opts+=("$n")
  done
  [ ${#opts[@]} -gt 0 ] || { note "本机没装任何备份脚本（opsget -i backup/<名字>）"; return 1; }
  if [ ${#opts[@]} -eq 1 ]; then
    confirm "运行本机的 ${opts[0]}.sh？" y && backup_run "${opts[0]}"
    return
  fi
  for i in "${!opts[@]}"; do printf '  [%d] %s\n' $((i + 1)) "${opts[i]}"; done
  printf '  [a] 全部依次执行\n'
  ask "选择" 1
  if [ "$ANS" = a ]; then
    flow_begin "立即备份"
    for n in "${opts[@]}"; do step "$n" backup_run "$n"; done
    flow_end
  elif [[ "$ANS" =~ ^[0-9]+$ ]] && [ "$ANS" -ge 1 ] && [ "$ANS" -le ${#opts[@]} ]; then
    backup_run "${opts[ANS-1]}"
  fi
}

do_compare() {
  ask "备份目录（取其中最新的两个包比对）" "$(env_get VW_BACKUP_DIR)"
  [ -d "$ANS" ] || { note "目录不存在：$ANS"; return 1; }
  run_ops ops/compare-backup-content "$ANS"
}

do_panelup() {
  run_ops ops/panel-backup-upload --list
  echo
  confirm "加密上传本地最新的面板备份包？" n || return 0
  ask "上传后云端只保留本机最近上传的几份？（回车=不清理）"
  if [ -z "$ANS" ]; then
    run_ops ops/panel-backup-upload
  elif [[ "$ANS" =~ ^[0-9]+$ ]]; then
    run_ops ops/panel-backup-upload --prune "$ANS"
  else
    note "需要一个数字：$ANS"; return 1
  fi
}

# ── 功能：安全与防火墙 ──────────────────────────────────────
